# Optional: enables Claude-written explanations and answers. Without it, deterministic templates are used.
ANTHROPIC_API_KEY=
DT_CLAUDE_MODEL=claude-sonnet-5-5
DT_CLAUDE_FAST_MODEL=claude-haiku-5-5
# Optional: attach Neo4j. Without it, the in-memory graph engine is used.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=decisiontrust
# Fixed clock so the demo data never goes stale. Remove for real time.
DT_DEMO_NOW=2026-11-22T10:00:00Z
